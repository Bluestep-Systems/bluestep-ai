{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-generated-files.sh"
          }
        ]
      },
      {
        "matcher": "mcp__(Claude_Browser|claude-in-chrome)__(javascript_tool|browser_batch)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/tab-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(b6p *)",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(b6p *)",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*bluestep-gateway__invoke_org_tool",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      },
      {
        "matcher": "mcp__(Claude_Browser|claude-in-chrome)__(javascript_tool|browser_batch)",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(b6p *)",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(b6p *)",
            "async": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/change-log.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/canary.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/compact-reminder.sh"
          }
        ]
      }
    ]
  }
}
